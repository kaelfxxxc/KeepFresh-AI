# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook OAuth
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Barcode Lookup API key — used ONLY server-side by the Supabase Edge Function
# `barcode-lookup`. Keep this WITHOUT the EXPO_PUBLIC_ prefix (so it never ships
# in the app bundle) and mirror its value as a Supabase secret instead:
#   supabase secrets set BARCODE_SCANNER_API_KEY="<value>"
BARCODE_SCANNER_API_KEY=