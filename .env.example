# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook OAuth
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Barcode lookup
#
# No key, and nothing to set here. Barcode lookups read Open Food Facts
# (world.openfoodfacts.org), an open database that answers unauthenticated HTTPS
# GETs, so the app calls it directly. The old Barcode Lookup key
# (BARCODE_SCANNER_API_KEY) belonged to a paid plan that has lapsed; the
# `barcode-lookup` edge function that used to hold it now proxies Open Food Facts
# and needs no secret either.

# PayMongo
#
# The public key is NOT needed by the app: checkout is a hosted page the server
# creates, so nothing on the device ever talks to PayMongo directly. It is kept
# here only as a reference. Both of the keys that matter are server-side secrets:
#   supabase secrets set PAYMONGO_SECRET_KEY="sk_live_..."          # sk_test_... while testing
#   supabase secrets set PAYMONGO_WEBHOOK_SECRET="whsk_..."
#
# NEVER put the secret key in this file. `.env` is read by the app build and its
# EXPO_PUBLIC_ values are inlined into the shipped JavaScript bundle.
PAYMONGO_PUBLIC_KEY=

# Switches the plan buttons on. A build flag, not a security control: the server
# checks its own secrets before it will create a checkout session and refuses
# cleanly if they are missing, so a build with this set against an unconfigured
# server shows an honest error rather than failing silently.
EXPO_PUBLIC_PAYMONGO_ENABLED=false