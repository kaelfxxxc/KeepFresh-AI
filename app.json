{
  "expo": {
    "name": "KeepFresh AI",
    "slug": "keepfresh-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/keepfresh-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "keepfreshai",
    "splash": {
      "image": "./assets/images/keepfresh-splash-logo.png",
      "imageWidth": 100,
      "resizeMode": "contain",
      "backgroundColor": "#168A45"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keepfreshai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "KeepFresh AI needs camera access to scan product barcodes",
        "NSPhotoLibraryUsageDescription": "KeepFresh AI needs photo library access to upload product images",
        "NSPhotoLibraryAddUsageDescription": "KeepFresh AI needs to save photos to your library"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/keepfresh-icon.png",
        "backgroundColor": "#168A45"
      },
      "package": "com.keepfreshai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/images/keepfresh-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/keepfresh-splash-logo.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#168A45"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KeepFresh AI to access your camera to scan product barcodes"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KeepFresh AI to access your photos to upload product images",
          "cameraPermission": "Allow KeepFresh AI to access your camera"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#168A45"
        }
      ],
      [
        "expo-secure-store",
        {}
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "keepfresh-ai"
      }
    }
  }
}